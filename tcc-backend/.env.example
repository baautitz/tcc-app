NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://tcc:tcc_local_password@localhost:5432/tcc_platform
FRONTEND_ORIGIN=http://localhost:5173
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENCRYPTION_KEY=substitua-por-uma-chave-base64-de-32-bytes
SESSION_TTL_DAYS=7

# IA opcional: mantenha AI_API_KEY vazia para deixar a IA desabilitada.
# AI_BASE_URL aponta para a base OpenAI-compatible (normalmente terminada em /v1).
# O provedor precisa aceitar streaming e tools/tool_calls (Chat Completions ou Responses API).
# Os valores abaixo são os da rodada oficial de avaliação (GPT-5.4 mini, raciocínio baixo).
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-5.4-mini
AI_REQUEST_TIMEOUT_MS=180000
# Esforço de raciocínio (minimal, low, medium, high) para modelos que o aceitam; deixe vazio nos demais.
AI_REASONING_EFFORT=low
# "true" usa a Responses API da OpenAI, exigida pelo GPT-5.4 com ferramentas e raciocínio.
# Use "false" em provedores que só oferecem Chat Completions.
AI_USE_RESPONSES_API=true

# Fonte usada pelas queries do dashboard de demonstração criado pelo seed.
OLIST_SOURCE_HOST=127.0.0.1
OLIST_SOURCE_PORT=5433
OLIST_SOURCE_DATABASE=olist
OLIST_SOURCE_USERNAME=olist_reader
OLIST_SOURCE_PASSWORD=olist_readonly_password

# Telemetria de medição (OpenTelemetry -> um span por linha em JSONL). Vazio = desligada.
# TELEMETRY_FILE=./telemetry/ai.jsonl
# Identificador opaco da sessão de teste (ex.: P01); também aceito no header X-Participant-Id.
# TELEMETRY_PARTICIPANT=P01
