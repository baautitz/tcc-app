NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://tcc:tcc_local_password@localhost:5432/tcc_platform
FRONTEND_ORIGIN=http://localhost:5173
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENCRYPTION_KEY=substitua-por-uma-chave-base64-de-32-bytes
SESSION_TTL_DAYS=7

# IA opcional: mantenha AI_API_KEY vazia para deixar a IA desabilitada.
# AI_BASE_URL aponta para a base OpenAI-compatible (normalmente terminada em /v1).
# O provedor precisa aceitar Chat Completions, streaming SSE e tools/tool_calls.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_REQUEST_TIMEOUT_MS=60000

# Fonte usada pelas queries do dashboard de demonstração criado pelo seed.
OLIST_SOURCE_HOST=127.0.0.1
OLIST_SOURCE_PORT=5433
OLIST_SOURCE_DATABASE=olist
OLIST_SOURCE_USERNAME=olist_reader
OLIST_SOURCE_PASSWORD=olist_readonly_password
