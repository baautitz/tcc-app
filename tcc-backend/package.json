{
  "name": "tcc-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:context-approvals": "bash scripts/smoke-context-approvals.sh"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.9",
    "@langchain/core": "^1.2.13",
    "@langchain/langgraph": "^1.4.19",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.5",
    "@langchain/openai": "^1.6.0",
    "@node-rs/argon2": "^2.0.2",
    "drizzle-orm": "^0.44.7",
    "hono": "^4.11.4",
    "langchain": "^1.5.14",
    "pg": "^8.16.3",
    "pg-cursor": "^2.22.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@types/pg": "^8.15.5",
    "@types/pg-cursor": "^2.7.2",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
