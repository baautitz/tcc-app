{
  "name": "tcc-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "db:migrate": "tsx src/shared/db/migrate.ts",
    "db:seed": "tsx src/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:context-approvals": "bash scripts/smoke-context-approvals.sh",
    "arch": "depcruise src",
    "format": "prettier --write \"{src,tests}/**/*.{ts,tsx,css,json}\" \"*.{ts,cjs,json}\"",
    "format:check": "prettier --check \"{src,tests}/**/*.{ts,tsx,css,json}\" \"*.{ts,cjs,json}\""
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@langchain/core": "^1.3.5",
    "@langchain/langgraph": "^1.7.2",
    "@langchain/langgraph-checkpoint-postgres": "^1.1.2",
    "@langchain/openai": "^1.8.2",
    "@node-rs/argon2": "^2.2.2",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.17",
    "langchain": "^1.6.3",
    "pg": "^8.23.1",
    "pg-cursor": "^2.22.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.15.5",
    "@types/pg-cursor": "^2.7.2",
    "dependency-cruiser": "18.7.2",
    "drizzle-kit": "^0.31.4",
    "prettier": "3.9.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
