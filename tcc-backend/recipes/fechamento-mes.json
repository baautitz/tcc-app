{
  "id": "fechamento_mes_readonly",
  "name": "Fechamento de Mês - Consulta",
  "description": "Dashboard de consulta do fechamento mensal.",
  "workspace": {
    "params": [
      {
        "name": "start_date",
        "label": "Data Inicial",
        "type": "date",
        "required": true
      },
      {
        "name": "end_date",
        "label": "Data Final",
        "type": "date",
        "required": true
      },
      {
        "name": "categories_focus",
        "label": "Categorias em Foco",
        "type": "multi_select",
        "required": false,
        "lookup": {
          "source": "olist",
          "query": "SELECT category_name AS value, COALESCE(category_name_english, category_name) AS label FROM olist.categories ORDER BY label"
        }
      }
    ]
  },
  "sources": {
    "olist": {
      "queries": {
        "vendas": {
          "primaryKey": "vendedor_id",
          "columns": [
            {
              "name": "vendedor_id",
              "type": "text",
              "label": "ID Vendedor"
            },
            {
              "name": "vendedor",
              "type": "text",
              "label": "Vendedor"
            },
            {
              "name": "venda_geral",
              "type": "money",
              "label": "Venda Geral"
            }
          ],
          "options": [
            {
              "id": "todos",
              "label": "Todos os vendedores",
              "permission": "recipe:fechamento_mes_readonly:query:vendas_equipe",
              "sql": "SELECT oi.seller_id AS vendedor_id, CONCAT(city.name, '/', city.state_code, ' · ', oi.seller_id) AS vendedor, SUM(oi.price) AS venda_geral FROM olist.orders o INNER JOIN olist.order_items oi ON oi.order_id = o.order_id INNER JOIN olist.products p ON p.product_id = oi.product_id INNER JOIN olist.sellers s ON s.seller_id = oi.seller_id INNER JOIN olist.cities city ON city.city_id = s.city_id WHERE o.purchased_at >= {{workspace.start_date}}::date AND o.purchased_at < ({{workspace.end_date}}::date + INTERVAL '1 day') AND ({{workspace.categories_focus}}::text[] IS NULL OR p.category_name = ANY({{workspace.categories_focus}}::text[])) GROUP BY oi.seller_id, city.name, city.state_code"
            }
          ]
        },
        "total_vendas": {
          "primaryKey": "total_vendas",
          "columns": [
            {
              "name": "total_vendas",
              "type": "money",
              "label": "Total de Vendas"
            }
          ],
          "options": [
            {
              "id": "total",
              "label": "Total",
              "permission": "recipe:fechamento_mes_readonly:query:total_vendas",
              "sql": "SELECT COALESCE(SUM(oi.price), 0) AS total_vendas FROM olist.orders o INNER JOIN olist.order_items oi ON oi.order_id = o.order_id INNER JOIN olist.products p ON p.product_id = oi.product_id WHERE o.purchased_at >= {{workspace.start_date}}::date AND o.purchased_at < ({{workspace.end_date}}::date + INTERVAL '1 day') AND ({{workspace.categories_focus}}::text[] IS NULL OR p.category_name = ANY({{workspace.categories_focus}}::text[]))"
            }
          ]
        }
      }
    }
  },
  "ui": {
    "layout": {
      "type": "grid",
      "columns": 12,
      "gap": 16
    },
    "components": [
      {
        "id": "kpi_total_vendas",
        "component": "stat_card",
        "layoutProps": {
          "colSpan": 12
        },
        "props": {
          "title": "Total em Produtos",
          "source": "olist",
          "query": "total_vendas",
          "field": "total_vendas",
          "format": "currency",
          "icon": "DollarSign"
        }
      },
      {
        "id": "grafico_ranking_vendas",
        "component": "bar_chart",
        "layoutProps": {
          "colSpan": 6,
          "rowSpan": 2
        },
        "props": {
          "title": "Ranking de Vendas por Vendedor",
          "source": "olist",
          "query": "vendas",
          "nameKey": "vendedor",
          "valueKey": "venda_geral",
          "limit": 5
        }
      },
      {
        "id": "grafico_distribuicao_vendas",
        "component": "pie_chart",
        "layoutProps": {
          "colSpan": 6,
          "rowSpan": 2
        },
        "props": {
          "title": "Distribuição das Vendas por Vendedor",
          "source": "olist",
          "query": "vendas",
          "nameKey": "vendedor",
          "valueKey": "venda_geral"
        }
      },
      {
        "id": "tabela_vendedores",
        "component": "data_table",
        "layoutProps": {
          "colSpan": 12
        },
        "props": {
          "title": "Vendas por Vendedor",
          "source": "olist",
          "query": "vendas",
          "columns": [
            {
              "key": "vendedor_id",
              "label": "ID",
              "sortable": true
            },
            {
              "key": "vendedor",
              "label": "Vendedor",
              "sortable": true,
              "searchable": true
            },
            {
              "key": "venda_geral",
              "label": "Venda Geral",
              "format": "currency",
              "sortable": true
            }
          ],
          "pagination": {
            "pageSize": 10
          }
        }
      }
    ]
  }
}
